

POST http://localhost:5000/api/auth/register
Body JSON :
{
  "email": "test@test.com",
  "password": "123456",
  "role": "formateur"
},
POST http://localhost:5000/api/auth/register
Body JSON :
{
  "email": "test@institution.com",
  "password": "123456",
  "role": "institutions"
}

// Voir un profil
GET http://localhost:5000/api/formateurs/1

GET http://localhost:5000/api/auth/me

// Modifier un profil (avec token dans Authorization)
PUT http://localhost:5000/api/formateurs/1
Body JSON :
{
  "nom": "Dupont",
  "prenom": "Jean",
  "bio": "Formateur en développement web",
  "competences": ["React", "Node.js", "PostgreSQL"],
  "localisation": "Paris"
}


# Offre and Candidature 

// 1. Créer une offre (token institution)
POST http://localhost:5000/api/offres
{
  "titre": "Formateur en développement web",
  "description": "Nous recherchons un formateur expérimenté en React et Node.js",
  "competences": ["React", "Node.js", "PostgreSQL"],
  "localisation": "Brazzaville, Congo"
}

// 2. Lister les offres (public)
GET http://localhost:5000/api/offres

// 3. Postuler (token formateur)
POST http://localhost:5000/api/candidatures
{
  "offre_id": 1,
  "message": "Je suis très intéressé par cette offre, j'ai 3 ans d'expérience en React et Node.js"
}


// Créer une formation (token formateur)
POST http://localhost:5000/api/formations
{
  "titre": "Formation React.js de A à Z",
  "description": "Apprenez React.js depuis les bases jusqu'aux concepts avancés",
  "duree": 40,
  "prix": 150000,
  "niveau": "débutant"
}

// Lister toutes les formations (public)
GET http://localhost:5000/api/formations


// Rechercher formateurs par compétence
GET http://localhost:5000/api/formateurs?competence=React

// Rechercher formateurs par localisation
GET http://localhost:5000/api/formateurs?localisation=Brazzaville

// Rechercher offres
GET http://localhost:5000/api/offres/search?competence=React

// Rechercher avec plusieurs filtres
GET http://localhost:5000/api/offres/search?competence=React&localisation=Brazzaville


// Envoyer un message (token formateur → institution user_id = 2)
POST http://localhost:5000/api/messages
{
  "destinataire_id": 2,
  "contenu": "Bonjour, je suis intéressé par votre offre de formateur en développement web."
}

// Voir la conversation avec l'utilisateur 2
GET http://localhost:5000/api/messages/2

// Voir toutes ses conversations
GET http://localhost:5000/api/messages/conversations

// Noter un utilisateur (token formateur → noter l'institution user_id = 2)
POST http://localhost:5000/api/evaluations
{
  "cible_id": 2,
  "note": 4,
  "commentaire": "Très bonne institution, communication claire et rapide."
}

// Voir les évaluations d'un utilisateur (public)
GET http://localhost:5000/api/evaluations/2


// Login admin
POST http://localhost:5000/api/auth/login
{
  "email": "admin@findtraining.com",
  "password": "password"
}

// Stats (token admin)
GET http://localhost:5000/api/admin/stats

// Tous les users (token admin)
GET http://localhost:5000/api/admin/users